# white-label-admin — production channel. Committed to a PUBLIC repo: no secrets here.
# Secrets go in the GitHub Environment "production" as ENV_WHITE_LABEL_ADMIN (dotenv
# text, merged over this file at build time). Every value, from this file or
# the secret, is baked into the app and readable by anyone who downloads it.
#
# Set by the launcher on every start — values here are ignored:
#   DATABASE_URL, PORT, HOSTNAME, AUTH_URL, AUTH_TRUST_HOST, NODE_ENV, SUPPLIER_HUB_URL,
#   SUPPLIER_HUB_REDIS_URL (supplier-hub's Redis, where the admin writes the hub's settings)
# Minted per install into config.json unless that file already has them:
#   AUTH_SECRET, B2C_API_SECRET, THEME_WEBHOOK_SECRET, AI_CHAT_VISITOR_SECRET
# NEXT_PUBLIC_* values are compiled into the build, so they take effect only
# in the next release, never through config.json.

# Supplier API (core-api) the flight module calls; credentials go in the secret.
SUPPLIER_API_URL=
# SUPPLIER_CLIENT_ID=     (secret)
# SUPPLIER_CLIENT_SECRET= (secret)

NEXT_PUBLIC_B2C_URL=
PAYMENT_GATEWAY_SANDBOX=0

# Background workers ("off" disables). A test build must not mail real customers.
JOBS_WORKER=on
PRICE_ALERTS_WORKER=on
