# supplier-hub — test channel. Committed to a PUBLIC repo: no secrets here.
# Secrets go in the GitHub Environment "test" as ENV_SUPPLIER_HUB (dotenv text,
# merged over this file at build time); they ship inside the app.
#
# Set by the launcher on every start — values here are ignored:
#   APP_HOST, APP_PORT, APP_URL, REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, QUEUE_CONNECTION
# Minted per install into config.json: APP_KEY
# CORE_API_URL defaults to the bundled admin; set it here to use a hosted core-api.

APP_NAME="Supplier Hub"
APP_ENV=local
APP_DEBUG=true
LOG_CHANNEL=daily
LOG_LEVEL=debug

CORE_API_URL=
ADDONS_API_URL=
# No broker on a desktop; supplier-hub must treat an empty list as "Kafka off".
KAFKA_BROKERS=

# Hosted supplier services, fixed per build (e.g. https://abc.com). Every supplier's
# URL is built from it: subdomain https://sabre.abc.com/api/, path https://abc.com/sabre/api/.
SUPPLIER_BASE_URL=https://air.ibos.io
SUPPLIER_URL_STYLE=path
# Services not named after their code (see SupplierURL.go in supplier-hub).
SUPPLIER_SERVICE_BS=us-bangla
SUPPLIER_SERVICE_2A=air-astra
SUPPLIER_SERVICE_NZ=nz-trip
SUPPLIER_SERVICE_1GNDC=travelport-ndc
SUPPLIER_SERVICE_1Gxxxx=travelport-soap
